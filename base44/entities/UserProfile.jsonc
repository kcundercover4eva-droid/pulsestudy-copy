{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "accentColor": {
      "type": "string",
      "enum": [
        "coral",
        "neonGreen",
        "electricBlue"
      ],
      "default": "neonGreen"
    },
    "motivationStyle": {
      "type": "string",
      "enum": [
        "positive",
        "negative"
      ],
      "default": "positive"
    },
    "weeklyGoalHours": {
      "type": "number",
      "default": 10
    },
    "totalPoints": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "number",
      "default": 0
    },
    "currentStreak": {
      "type": "number",
      "default": 0
    },
    "lastStreakDate": {
      "type": "string",
      "format": "date"
    },
    "lastDopamineDropDate": {
      "type": "string",
      "format": "date"
    },
    "hasCompletedOnboarding": {
      "type": "boolean",
      "default": false
    },
    "hasSeenPomodoroIntro": {
      "type": "boolean",
      "default": false
    },
    "hasSeenScheduleIntro": {
      "type": "boolean",
      "default": false
    },
    "hasSeenGenerateIntro": {
      "type": "boolean",
      "default": false
    },
    "hasSeenQuizIntro": {
      "type": "boolean",
      "default": false
    },
    "hasUnlockedSprint": {
      "type": "boolean",
      "default": false
    },
    "aiAssistantEnabled": {
      "type": "boolean",
      "default": true
    },
    "hasSeenFirstUploadCelebration": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has seen the first-upload celebration modal"
    },
    "dailyGoalTarget": {
      "type": "number",
      "default": 10,
      "description": "Number of cards/notes/quizzes to review per day"
    },
    "dailyReviewCount": {
      "type": "number",
      "default": 0,
      "description": "How many items reviewed today"
    },
    "lastReviewDate": {
      "type": "string",
      "format": "date",
      "description": "Date of last review activity"
    },
    "uploadedMaterials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "uploadedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "learningPreferences": {
      "type": "object",
      "properties": {
        "preferredMethods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "weakMethods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "subjectNotes": {
          "type": "object",
          "default": {}
        },
        "totalTutorSessions": {
          "type": "number",
          "default": 0
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      },
      "default": {}
    }
  },
  "required": []
}