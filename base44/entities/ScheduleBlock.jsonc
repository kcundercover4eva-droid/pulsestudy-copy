{
  "name": "ScheduleBlock",
  "type": "object",
  "properties": {
    "day": {
      "type": "number",
      "description": "0-6 representing Mon-Sun"
    },
    "start": {
      "type": "number",
      "description": "Start hour (0-24, float allowed for minutes)"
    },
    "end": {
      "type": "number",
      "description": "End hour (0-24, float allowed for minutes)"
    },
    "type": {
      "type": "string",
      "enum": [
        "school",
        "sleep",
        "study",
        "extracurricular",
        "other"
      ],
      "default": "study"
    },
    "title": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "description": "Hex color code for the block"
    }
  },
  "required": [
    "day",
    "start",
    "end",
    "type"
  ]
}